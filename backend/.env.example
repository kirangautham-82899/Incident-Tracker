# Copy this file to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=5000

# MongoDB connection string
# Local:  mongodb://localhost:27017/incident-tracker
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/incident-tracker
MONGODB_URI=mongodb://localhost:27017/incident-tracker

# JWT secret - use a long random string (required in production)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30d

# Frontend origin(s) allowed by CORS, comma separated (*.vercel.app is always allowed)
FRONTEND_URL=http://localhost:5173

# Public base URL of this API, used to build links to locally stored uploads
# PUBLIC_URL=https://your-api.up.railway.app

# Cloudinary (optional). Without it, uploads are stored in backend/uploads/
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
