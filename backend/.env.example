# Copy this file to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=5000

# Supabase Postgres connection string
# Supabase dashboard -> Project -> Connect -> "Session pooler" (port 5432).
# On Vercel/serverless use the "Transaction pooler" (port 6543) and DB_POOL_SIZE=1.
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# DB_POOL_SIZE=10
# The API applies db/schema.sql on startup; set to false to manage the schema yourself
# DB_AUTO_MIGRATE=true

# Supabase Storage for photos/videos (Project Settings -> API).
# The service_role key is secret: keep it on the server only.
# Without these, uploads are stored in backend/uploads/ (local dev only).
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=incident-media

# JWT secret - use a long random string (required in production)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30d

# Frontend origin(s) allowed by CORS, comma separated (*.vercel.app is always allowed)
FRONTEND_URL=http://localhost:5173

# Public base URL of this API, used for links to locally stored uploads
# PUBLIC_URL=https://your-api.onrender.com
